# ─────────────────────────────────────────────────────────────
# market-agent · Telegram → Instagram carousel tunnel
# Copy to .env and fill in. .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────

# ── Telegram (MTProto, your own user account) ────────────────
# Get these at https://my.telegram.org → "API development tools".
# Tied to YOUR phone number, not to the channel. Read-only
# membership in the source channel is enough.
TG_API_ID=
TG_API_HASH=

# Left blank on first run. The login flow prints a session string
# to the console — paste it here and it never asks again.
TG_SESSION=

# Source channel: @username, t.me link, or numeric -100... id.
TG_SOURCE_CHANNEL=

# Where the daemon DMs you run receipts and failure alerts.
# "me" = Saved Messages. Safe default, no extra setup.
TG_ALERT_TARGET=me

# ── Instagram (browser automation) ───────────────────────────
IG_HANDLE=marketalert.il
# Dedicated Chrome profile dir, kept OUT of the repo so a stray
# git add can never publish a live session cookie.
IG_USER_DATA_DIR=/Users/ofirmalka/Library/Application Support/market-agent/chrome-profile

# ── Market data feed (NQ / ES / YM for the tape strip) ───────
# TODO: not yet decided. Fill in once the feed is chosen.
FEED_URL=
FEED_KEY=

# ── Windowing ────────────────────────────────────────────────
TZ=Asia/Jerusalem
WINDOW_MINUTES=15
MAX_SLIDES=10
# The 23:00 deck spends one slide on the Telegram CTA card.
MAX_SLIDES_WITH_CTA=9

# ── Safety rails ─────────────────────────────────────────────
# DRY_RUN=1 renders + stages everything but stops one click
# before Share. Keep it at 1 until a supervised live post passes.
DRY_RUN=1
MAX_POSTS_PER_DAY=12
MIN_MINUTES_BETWEEN_POSTS=12
# Daemon halts after this many consecutive publish failures.
PAUSE_AFTER_FAILURES=2
# Touch this file to stop the daemon without killing the process.
KILL_SWITCH=./PAUSED

# ── Paths ────────────────────────────────────────────────────
DB_PATH=./state.db
OUT_DIR=./out
